# ============================================
# LUCHAT PRODUCTION - RENDER DEPLOYMENT
# Set these as Environment Variables in Render
# ============================================

# Django Settings
SECRET_KEY=generate-a-long-random-string-here-50-chars-minimum
DEBUG=False
ALLOWED_HOSTS=.onrender.com,YOUR_CUSTOM_DOMAIN

# CSRF (add your Render URL and custom domain)
CSRF_TRUSTED_ORIGINS=https://luchat.onrender.com,https://YOUR_CUSTOM_DOMAIN

# Database (Neon PostgreSQL)
# Get from: console.neon.tech -> Connection Details -> Connection String
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Redis (Upstash)
# Get from: console.upstash.com -> Your Database -> REST API
REDIS_URL=rediss://default:password@xxx.upstash.io:6379

# Celery (same as Redis)
CELERY_BROKER_URL=rediss://default:password@xxx.upstash.io:6379

# Payments (MegaPay)
MEGAPAY_API_KEY=MGPYl2DC613a
MEGAPAY_EMAIL=georgerubinga@gmail.com
MEGAPAY_BASE_URL=https://megapay.co.ke/backend/v1
USE_LOCAL_MEGAPAY_STUB=False

# Python Version
PYTHON_VERSION=3.11.0
